edit /definition
set ./format string "cli-definition-v1"
set ./id string "services"
set ./description string "Independent service component."
set ./contexts object
set ./contexts/root object
set ./contexts/root/parent null
set ./contexts/root/help string "Inspect and configure services."
set ./contexts/root/related array
set ./contexts/root/commands object
